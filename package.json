{
  "name": "nastud-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Toplo accident and maintenance count, daily timeline and steam toy",
  "scripts": {
    "build": "node build.mjs",
    "build:fixture": "node build.mjs --data test/fixtures/timeline.json --incidents test/fixtures/incidents.json --incident-daily test/fixtures/incident-daily.json",
    "check": "pnpm test && pnpm build:fixture",
    "dev": "node serve.mjs",
    "test": "node --test test/*.test.mjs",
    "test:run": "node --test test/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicense",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
